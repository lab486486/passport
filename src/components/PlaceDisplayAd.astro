---
import DisplayAd from "./DisplayAd.astro";
import { hasDisplayAd } from "../utils/adsense";
---

{hasDisplayAd() && <DisplayAd />}

<script>
  const guard = window.PassportAdsense;
  if (guard?.isBlocked()) {
    document.querySelectorAll("[data-display-ad], .ad-unit").forEach((el) => el.remove());
  } else if (guard) {
    const ad = document.querySelector("[data-display-ad]:not([data-ad-placed])");
    if (ad) {
      ad.setAttribute("data-ad-placed", "1");
      const main = ad.closest("main.prose");
      const box = main && main.querySelector(".container");
      if (box && box.contains(ad)) {
        const cta = box.querySelector(".calc-cta");
        const h2 = box.querySelector("h2");
        if (cta) {
          cta.after(ad);
        } else if (h2) {
          h2.before(ad);
        } else {
          const h1 = box.querySelector("h1");
          let node = h1 ? h1.nextElementSibling : null;
          let last: Element | null = null;
          while (node && node.tagName === "P") {
            last = node;
            node = node.nextElementSibling;
          }
          if (last) last.after(ad);
        }
      }
      guard.fillPendingAdSlots();
      guard.push();
    }
  }
</script>
