  </defs>
  <circle cx="32" cy="32" r="30.6" stroke="#c4a35a" stroke-width="1.55" />
  <g stroke="#c4a35a" stroke-width="1.3" stroke-linejoin="round">
    <path d="M32 6.6 C37.6 10 40.2 16.6 32 22.8 C23.8 16.6 26.4 10 32 6.6 Z" />
    <path
