---
import { getAdsenseConfig, hasHeadScript } from "../utils/adsense";

const adScriptSrc = getAdsenseConfig().head_script.match(/src="([^"]+)"/)?.[1] ?? "";
---

{
  hasHeadScript() && adScriptSrc && (
    <script is:inline src="/js/adsense-guard.js" data-ad-script-src={adScriptSrc}></script>
  )
}
