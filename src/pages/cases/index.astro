---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { stories } from "../../data/stories";
import PlaceDisplayAd from "../../components/PlaceDisplayAd.astro";
---

<Layout
  title="입국 거부 사례"
  description="항공기 탑승 거절과 입국 금지 사례를 모았습니다. 사증란, 여권 잔여기간, 사진·훼손 문제를 확인하세요."
>
  <Header />
  <main id="main" class="prose">
    <div class="container">
      <nav class="crumbs" aria-label="현재 위치">
        <a href="/">🏠 홈</a>
        <span aria-hidden="true">›</span>
        <span>입국 거부 사례</span>
      </nav>
      <h1>입국 거부 사례</h1>
      <p>잔여기간이 있어도 탑승이나 입국이 거절된 사례입니다. 출발 전에 같이 확인하세요.</p>
      <div class="story-list">
        {stories.map((item) => <a class="story-link" href={item.href} set:html={item.hookHtml} />)}
      </div>
      <PlaceDisplayAd />
    </div>
  </main>
  <Footer />
</Layout>
